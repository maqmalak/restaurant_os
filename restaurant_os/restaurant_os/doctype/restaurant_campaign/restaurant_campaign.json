{
 "doctype": "DocType",
 "name": "Restaurant Campaign",
 "module": "Restaurant OS",
 "custom": 0,
 "engine": "InnoDB",
 "creation": "2026-10-20 12:00:00.000000",
 "modified": "2026-10-20 12:00:00.000000",
 "modified_by": "Administrator",
 "owner": "Administrator",
 "description": "A message to a customer group (WhatsApp / SMS), optionally with a coupon.",
 "istable": 0,
 "issingle": 0,
 "editable_grid": 0,
 "field_order": [
  "title",
  "segment",
  "lapsed_days",
  "top_n",
  "column_break_a",
  "channel",
  "pos_coupon",
  "status",
  "section_message",
  "message",
  "section_result",
  "recipients_count",
  "sent_on",
  "recipients"
 ],
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Campaign",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "segment",
   "fieldtype": "Select",
   "label": "Who",
   "options": "Lapsed customers\nNew this month\nTop spenders\nEveryone with a mobile",
   "default": "Lapsed customers",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "lapsed_days",
   "fieldtype": "Int",
   "label": "Not Ordered For (days)",
   "default": "30",
   "depends_on": "eval:doc.segment=='Lapsed customers'"
  },
  {
   "fieldname": "top_n",
   "fieldtype": "Int",
   "label": "How Many Top Spenders",
   "default": "20",
   "depends_on": "eval:doc.segment=='Top spenders'"
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Send By",
   "options": "WhatsApp\nSMS",
   "default": "WhatsApp"
  },
  {
   "fieldname": "pos_coupon",
   "fieldtype": "Link",
   "label": "Coupon",
   "options": "POS Coupon",
   "description": "Its code is put in the message as {coupon}"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nSent",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_message",
   "fieldtype": "Section Break",
   "label": "Message"
  },
  {
   "fieldname": "message",
   "fieldtype": "Small Text",
   "label": "Message",
   "reqd": 1,
   "default": "Hi {name}, we miss you at {restaurant}! Use code {coupon} on your next order: {link}",
   "description": "{name}, {restaurant}, {coupon}, {link} are filled in per customer"
  },
  {
   "fieldname": "section_result",
   "fieldtype": "Section Break",
   "label": "Result"
  },
  {
   "fieldname": "recipients_count",
   "fieldtype": "Int",
   "label": "Recipients",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sent_on",
   "fieldtype": "Datetime",
   "label": "Sent On",
   "read_only": 1
  },
  {
   "fieldname": "recipients",
   "fieldtype": "Table",
   "label": "Recipients",
   "options": "Restaurant Campaign Recipient",
   "read_only": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Sales User",
   "read": 1,
   "report": 1,
   "print": 1
  },
  {
   "role": "Stock User",
   "read": 1,
   "report": 1,
   "print": 1
  }
 ],
 "sort_field": "creation",
 "sort_order": "DESC",
 "states": [],
 "track_changes": 1,
 "row_format": "Dynamic",
 "actions": [],
 "links": [],
 "autoname": "format:CMP-{YY}-{###}",
 "title_field": "title",
 "show_title_field_in_link": 1
}
