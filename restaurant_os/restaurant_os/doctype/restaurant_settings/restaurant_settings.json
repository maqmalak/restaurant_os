 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company"
  },
  {
   "fieldname": "default_branch",
   "fieldtype": "Link",
   "label": "Main Branch",
   "options": "Restaurant Branch",
   "description": "New counters and the dashboard default to it"
  },
  {
   "fieldname": "column_break_a",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "invoice_mode",
   "fieldtype": "Select",
   "label": "Counter Sales Posted As",
   "options": "POS Invoice\nSales Invoice",
   "default": "POS Invoice",
   "description": "POS Invoice: merged into Sales Invoices when the shift closes (POS Awesome). Sales Invoice: posted per sale."
  },
  {
   "fieldname": "section_tax",
   "fieldtype": "Section Break",
   "label": "Sales Tax"
  },
  {
   "fieldname": "apply_sales_tax",
   "fieldtype": "Check",
   "label": "Apply Sales Tax",
   "default": "1",
   "description": "Untick to sell without sales tax on every counter"
  },
  {
   "fieldname": "sales_tax_rate",
   "fieldtype": "Percent",
   "label": "Sales Tax Rate",
   "default": "18",
   "depends_on": "apply_sales_tax"
  },
  {
   "fieldname": "column_break_tax",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "tax_included_in_price",
   "fieldtype": "Select",
   "label": "Menu Prices",
   "options": "Tax added on top of item price\nTax included in item price",
   "default": "Tax added on top of item price",
   "depends_on": "apply_sales_tax"
  },
  {
   "fieldname": "sales_tax_template",
   "fieldtype": "Link",
   "label": "Tax Template",
   "options": "Sales Taxes and Charges Template",
   "read_only": 1
  },
  {
   "fieldname": "section_fbr",
   "fieldtype": "Section Break",
   "label": "FBR Point of Sale Integration",
   "collapsible": 1,
   "description": "Every counter sale is reported to FBR (PRAL); the FBR invoice number and its QR code print on the receipt."
  },
  {
   "fieldname": "fbr_enabled",
   "fieldtype": "Check",
   "label": "Report Sales to FBR"
  },
  {
   "fieldname": "fbr_mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Mock\nSandbox\nLive",
   "default": "Mock",
   "depends_on": "fbr_enabled",
   "description": "Mock: numbers are generated here and nothing is sent. Sandbox / Live: posted to the URL below."
  },
  {
   "fieldname": "fbr_pos_id",
   "fieldtype": "Data",
   "label": "FBR POS ID",
   "depends_on": "fbr_enabled",
   "description": "Issued by FBR when the POS is registered"
  },
  {
   "fieldname": "fbr_service_fee",
   "fieldtype": "Currency",
   "label": "FBR POS Service Fee per Invoice",
   "default": "1",
   "depends_on": "fbr_enabled",
   "description": "Added to every reported invoice (Rs 1 under the FBR POS scheme); 0 to leave it out"
  },
  {
   "fieldname": "column_break_fbr",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "fbr_url",
   "fieldtype": "Data",
   "label": "Post Invoice URL",
   "depends_on": "eval:doc.fbr_enabled && doc.fbr_mode!='Mock'",
   "description": "FBR sandbox / live PostData endpoint, or the local IMS fiscal component \u2014 as given by PRAL"
  },
  {
   "fieldname": "fbr_token",
   "fieldtype": "Password",
   "label": "Access Token",
   "depends_on": "eval:doc.fbr_enabled && doc.fbr_mode!='Mock'"
  },
  {
   "fieldname": "fbr_pct_code",
   "fieldtype": "Data",
   "label": "Default PCT Code",
   "depends_on": "fbr_enabled",
   "description": "Tariff code sent per item (set per item later if needed)"
  },
  {
   "fieldname": "fbr_block_on_failure",
   "fieldtype": "Check",
   "label": "Stop the Sale When FBR Fails",
   "depends_on": "fbr_enabled",
   "description": "Off: the sale completes and is re-sent later (hourly)"
  },
  {
   "fieldname": "section_payments",
   "fieldtype": "Section Break",
   "label": "Payment Modes",
   "description": "Offered at the counter in this order; the first is the default."
  },
  {
   "fieldname": "payment_modes",
   "fieldtype": "Table",
   "label": "Payment Modes",
   "options": "Restaurant Payment Mode"
  },
  {
   "fieldname": "section_stock",
   "fieldtype": "Section Break",
   "label": "Stock"
  },
  {
   "fieldname": "stock_deduction_moment",
   "fieldtype": "Select",
   "label": "Deduct Ingredients",
   "options": "On Order Completion\nOn Invoice Submit",
   "default": "On Order Completion",
   "description": "Recipe (BOM) ingredients leave the branch kitchen in a background job"
  },
  {
   "fieldname": "column_break_stock",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "run_jobs_inline",
   "fieldtype": "Check",
   "label": "Run Background Jobs Immediately",
   "default": "1",
   "description": "For a bench without a worker: stock deduction and notifications run in the request instead of the queue"
  },
  {
   "fieldname": "block_sold_out",
   "fieldtype": "Check",
   "label": "Block Sold-out Items",
   "default": "1",
   "description": "A dish whose ingredients can't cover the portion can't be sold (POS, tables); it shows as sold out everywhere"
  },
  {
   "fieldname": "section_kds",
   "fieldtype": "Section Break",
   "label": "Kitchen Display"
  },
  {
   "fieldname": "kds_amber_minutes",
   "fieldtype": "Int",
   "label": "Amber After (minutes)",
   "default": "8"
  },
  {
   "fieldname": "kds_sound",
   "fieldtype": "Check",
   "label": "Sound on New Ticket",
   "default": "1"
  },
  {
   "fieldname": "column_break_b",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "kds_red_minutes",
   "fieldtype": "Int",
   "label": "Red After (minutes)",
   "default": "15"
  },
  {
   "fieldname": "kds_default_order_type",
   "fieldtype": "Select",
   "label": "Counter Orders Are",
   "options": "Takeaway\nDine-in\nDelivery\nPickup",
   "default": "Takeaway"
  },
  {
   "fieldname": "section_delivery",
   "fieldtype": "Section Break",
   "label": "Delivery & Reviews"
  },
  {
   "fieldname": "rider_assignment",
   "fieldtype": "Select",
   "label": "Rider Assignment",
   "options": "Auto - Nearest\nAuto - Least Busy\nManual",
   "default": "Auto - Nearest"
  },
  {
   "fieldname": "rider_ping_seconds",
   "fieldtype": "Int",
   "label": "Rider Location Every (seconds)",
   "default": "15"
  },
  {
   "fieldname": "require_delivery_otp",
   "fieldtype": "Check",
   "label": "Rider Must Enter the Delivery Code",
   "description": "Else a photo or the code is proof of delivery"
  },
  {
   "fieldname": "rider_float_account",
   "fieldtype": "Link",
   "label": "Rider Cash Account",
   "options": "Account",
   "description": "Cash riders collect, until handed over at the counter"
  },
  {
   "fieldname": "avg_rider_speed_kmh",
   "fieldtype": "Float",
   "label": "Average Rider Speed (km/h)",
   "default": "20",
   "description": "For the customer's ETA"
  },
  {
   "fieldname": "column_break_c",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "review_delay_minutes",
   "fieldtype": "Int",
   "label": "Send Review Link After (minutes)",
   "default": "30"
  },
  {
   "fieldname": "low_rating_alert",
   "fieldtype": "Int",
   "label": "Alert Manager At Or Below (stars)",
   "default": "2"
  },
  {
   "fieldname": "section_online",
   "fieldtype": "Section Break",
   "label": "Online Ordering & Kiosk",
   "collapsible": 1
  },
  {
   "fieldname": "online_ordering_enabled",
   "fieldtype": "Check",
   "label": "Online Ordering Open",
   "default": "1",
   "description": "Public ordering site at /ros/order"
  },
  {
   "fieldname": "online_price_list",
   "fieldtype": "Link",
   "label": "Online Price List",
   "options": "Price List",
   "description": "Blank = the counter's price list"
  },
  {
   "fieldname": "delivery_fee",
   "fieldtype": "Currency",
   "label": "Delivery Fee",
   "default": "150"
  },
  {
   "fieldname": "delivery_fee_item",
   "fieldtype": "Link",
   "label": "Delivery Fee Item",
   "options": "Item"
  },
  {
   "fieldname": "column_break_online",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "min_order_amount",
   "fieldtype": "Currency",
   "label": "Minimum Online Order",
   "default": "500"
  },
  {
   "fieldname": "kiosk_enabled",
   "fieldtype": "Check",
   "label": "Self-order Kiosk Open",
   "default": "1",
   "description": "Kiosk at /ros/kiosk \u2014 orders wait as held sales on the counter until paid"
  },
  {
   "fieldname": "kiosk_idle_seconds",
   "fieldtype": "Int",
   "label": "Kiosk Resets After (seconds idle)",
   "default": "90"
  },
  {
   "fieldname": "section_online_pay",
   "fieldtype": "Section Break",
   "label": "Online Payment",
   "collapsible": 1
  },
  {
   "fieldname": "online_payment_enabled",
   "fieldtype": "Check",
   "label": "Accept Online Payment",
   "default": "1",
   "description": "Card / wallet at checkout, next to cash"
  },
  {
   "fieldname": "payment_gateway_mode",
   "fieldtype": "Select",
   "label": "Mode",
   "options": "Mock\nLive",
   "default": "Mock",
   "description": "Mock: a built-in test gateway \u2014 no money moves"
  },
  {
   "fieldname": "payment_gateway",
   "fieldtype": "Select",
   "label": "Provider",
   "options": "Safepay\nPayFast\nJazzCash\nEasypaisa\nBank Gateway",
   "default": "Safepay",
   "depends_on": "eval:doc.payment_gateway_mode=='Live'"
  },
  {
   "fieldname": "online_payment_mode",
   "fieldtype": "Link",
   "label": "Mode of Payment",
   "options": "Mode of Payment",
   "description": "Booked on the invoice when paid online"
  },
  {
   "fieldname": "column_break_op",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "gateway_merchant_id",
   "fieldtype": "Data",
   "label": "Merchant ID",
   "depends_on": "eval:doc.payment_gateway_mode=='Live'"
  },
  {
   "fieldname": "gateway_api_key",
   "fieldtype": "Password",
   "label": "API Key",
   "depends_on": "eval:doc.payment_gateway_mode=='Live'"
  },
  {
   "fieldname": "gateway_secret",
   "fieldtype": "Password",
   "label": "Secret / Webhook Key",
   "depends_on": "eval:doc.payment_gateway_mode=='Live'"
  },
